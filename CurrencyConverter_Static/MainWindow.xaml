<Window x:Class="CurrencyConverter_Static.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CurrencyConverter_Static" 
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        Title="Currency Converter" SizeToContent="WidthAndHeight" MinHeight="400" MinWidth="800" WindowStartupLocation="CenterScreen">
    <TabControl x:Name="tbMain" TabStripPlacement="Top">
        <TabItem Name="tbConverter" Header="Currency Converter">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="79*"/>
                    <ColumnDefinition Width="171*"/>
                    <ColumnDefinition Width="250*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="2" Width="800" CornerRadius="10" BorderThickness="5" Grid.ColumnSpan="3" Margin="100,0,100,0">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF32EDD8"/>
                            <GradientStop Color="#FF80D61D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>

                    <Rectangle Grid.Row="2">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF32EDD8"/>
                                <GradientStop Color="#FF80D61D" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>

                    </Rectangle>
                </Border>

                <StackPanel Grid.Row="0" Width="1000" Height="50" Orientation="Horizontal" Grid.ColumnSpan="3" Margin="0,5,0,5">
                    <Label Content="Currency Converter" Width="1000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                   FontSize="25" Foreground="#FF80D61D" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Left" Height="80" Width="1000" Grid.ColumnSpan="3">
                    <Label Height="40" Width="1000" Content="Converted Currency" HorizontalContentAlignment="Center"
                   VerticalContentAlignment="Center" FontSize="20"/>
                    <Label Name="lblCurrency" Height="40" Width="1000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                   FontSize="20" Content=""/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Height="60" Width="800" Grid.ColumnSpan="3" Margin="100,0,0,0">
                    <Label Content="Enter Amount:" Height="40" Width="150" Margin="35 0 0 0" VerticalAlignment="Bottom" Foreground="White"
                   FontSize="20"/>
                    <Label Content="From:" Height="40" Width="150" Margin="110 0 0 0" VerticalAlignment="Bottom" Foreground="White"
                   FontSize="20"/>
                    <Label Content="To:" Height="40" Width="150" Margin="130 0 0 0" VerticalAlignment="Bottom" Foreground="White"
                   FontSize="20"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Height="90" Width="800" VerticalAlignment="Bottom" Grid.ColumnSpan="3" Margin="100,0,0,0">
                    <TextBox Name="txtCurrency" Width="200" Height="30" Margin="40 0 0 0" FontSize="18" VerticalContentAlignment="Center"
                     VerticalAlignment="Top" PreviewTextInput="NumberValidationTextBox"/>
                    <ComboBox Name="cmbFromCurrency" Width="170" Height="30" Margin="60 0 40 0" FontSize="18" VerticalContentAlignment="Center"
                      VerticalAlignment="Top" MaxDropDownHeight="150"/>
                    <fa:ImageAwesome Icon="Exchange" Height="30" Width="30" Foreground="White" VerticalAlignment="Top"/>
                    <ComboBox Name="cmbToCurrency" Width="170" Height="30" Margin="40 0 0 0" FontSize="18" VerticalContentAlignment="Center"
                      VerticalAlignment="Top" MaxDropDownHeight="150"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Height="100" Width="1000" Orientation="Horizontal" Grid.ColumnSpan="3">
                    <Button Name="Convert" Height="40" Width="150" Content="Convert" Click="Convert_Click" 
                            Margin="350 0 20 0" Style="{StaticResource ButtonRound}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF32EDD8"/>
                                <GradientStop Color="#FF80D61D" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button Name="Clear" Height="40" Width="150" Content="Clear" Click="Clear_Click" 
                            Margin="0 0 20 0" Style="{StaticResource ButtonRound}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF32EDD8"/>
                                <GradientStop Color="#FF80D61D" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Row="4" Height="150" Width="800" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Grid.ColumnSpan="3" Margin="100,0,0,0">
                    <Image Height="150" Width="150" Source="/Images/convert_icon.png" VerticalAlignment="Top" 
                   HorizontalAlignment="Center" Margin="325 -15 0 0"/>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Name="tbMaster" Header="Currency Master" Height="20" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="50"
                            Width="1000" VerticalAlignment="Center">
                    <Label Content="Currency Master" Height="40" Width="1000" HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center" FontSize="25" FontWeight="Bold" Foreground="#FF80D61D"/>
                </StackPanel>

                <Border Grid.Row="1" Width="800" CornerRadius="10" BorderThickness="5" Margin="100,0,100,0">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF32EDD8"/>
                            <GradientStop Color="#FF80D61D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>

                    <Rectangle Grid.Row="1">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF32EDD8"/>
                                <GradientStop Color="#FF80D61D" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Height="40" Width="800"  Margin="100, 0">
                    <Label Height="40" Width="180" Content="Enter Amount:" Margin="180 0 0 0"
                           VerticalAlignment="Bottom" Foreground="White" FontSize="20"/>
                    <Label Height="40" Width="180" Content="Currency Name:" Margin="60 0 0 0" 
                           VerticalAlignment="Bottom" Foreground="White" FontSize="20"/>
                </StackPanel>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Height="60" Width="800"
                            VerticalAlignment="Bottom" Margin="100, 0">
                    <TextBox x:Name="txtAmount" Width="200" Height="30" Margin="180 0 0 0" PreviewTextInput="NumberValidationTextBox"
                             FontSize="18" VerticalContentAlignment="Center" VerticalAlignment="Top"/>
                    <TextBox x:Name="txtCurrencyName" Width="200" Height="30" Margin="40 0 0 0" FontSize="18" 
                             VerticalContentAlignment="Center" VerticalAlignment="Top" MaxLength="50" CharacterCasing="Upper"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Height="100" Width="1000" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="Save" Height="40" Width="150" Content="Save" Click="Save_Click" 
                            Margin="350 0 20 0" Style="{StaticResource ButtonRound}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF32EDD8"/>
                                <GradientStop Color="#FF80D61D" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button Name="cancel" Height="40" Width="150" Content="Cancel" Click="Cancel_Click" 
                            Margin="0 0 20 0" Style="{StaticResource ButtonRound}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF32EDD8"/>
                                <GradientStop Color="#FF80D61D" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="3" Height="200" Width="800" Margin="100, 0" VerticalAlignment="Top">
                    <DataGrid Name="dgvCurrency" AutoGenerateColumns="False" Height="180" Width="480"
                              Margin="10" Background="Transparent" CanUserAddRows="False"
                              SelectedCellsChanged="dgvCurrency_SelectedCellsChanged" SelectionUnit="Cell"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="Id" Header="Id" Width="100"
                                                CanUserResize="False" Visibility="Hidden"
                                                Binding="{Binding Path=Id}"/>
                            <DataGridTemplateColumn Header="" Width="70" IsReadOnly="True"
                                                    DisplayIndex="0">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image x:Name="Revise" Source="/Images/edit_icon.png" ToolTip="Edit"
                                               Width="20" Height="20"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="70" IsReadOnly="True"
                                                    DisplayIndex="1">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="/Images/delete_icon.png" ToolTip="Delete"
                                               Width="20" Height="20" x:Name="Delete"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn x:Name="Amount" Header="Amount" Width="100" CanUserResize="False"
                                                CanUserReorder="False" Binding="{Binding Path=Amount}"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn x:Name="CurrencyName" Header="Currency Name" Width="*" MinWidth="20"
                                                CanUserResize="False" CanUserReorder="False" IsReadOnly="True"
                                                Binding="{Binding Path=CurrencyName}"/>

                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                
            </Grid>
        </TabItem>
    </TabControl>
</Window>
